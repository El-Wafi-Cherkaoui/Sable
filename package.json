    "string-width": "^7.2.0",
    "tree-kill": "^1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  }
