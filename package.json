{
  "name": "sable-workspaces",
  "version": "0.2.2",
  "description": "A keyboard-first terminal workspace manager for developers.",
  "type": "module",
  "license": "MIT",
  "author": "Cherkaoui-El-Wafi <elwafi.cherkaoui@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/El-Wafi-Cherkaoui/Sable.git"
  },
  "bugs": {
    "url": "https://github.com/El-Wafi-Cherkaoui/Sable/issues"
  },
  "homepage": "https://github.com/El-Wafi-Cherkaoui/Sable#readme",
  "files": [
    "dist"
  ],
  "bin": {
    "sable": "dist/main.js"
  },
  "scripts": {
    "generate:logo": "node scripts/generate-ansi-logo.mjs",
    "prebuild": "npm run generate:logo",
    "build": "tsc -p tsconfig.json",
    "dev": "node --enable-source-maps dist/main.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^14.0.0",
    "env-paths": "^4.0.0",
    "string-width": "^7.2.0",
    "tree-kill": "^1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "sharp": "^0.35.4",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  }
}
